{
  "name": "cosmo-desk",
  "version": "0.1.0",
  "description": "Cosmo Desk: a case queue triage simulation for CodeSignal Learn and Hire",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run start:prod",
    "start:prod": "IS_PRODUCTION=true node server.js",
    "start:dev": "concurrently -n vite,api -c cyan,magenta \"npm run dev:vite\" \"npm run dev:api\"",
    "dev:vite": "vite",
    "dev:api": "PORT=${API_PORT:-3001} CONFIG_FILE=${CONFIG_FILE:-examples/it-service-desk/config.json} STATE_DIR=${STATE_DIR:-.dev-state} sh -c 'mkdir -p \"$STATE_DIR\" && node server.js'",
    "build": "vite build",
    "test": "node --test \"test/*.test.js\"",
    "validate": "node scripts/validate.js",
    "report": "node scripts/report.js",
    "pack": "node scripts/pack-release.js",
    "verify:release": "node scripts/verify-release.js release.tar.gz",
    "release:local": "npm run build && npm run pack && npm run verify:release"
  },
  "keywords": [
    "codesignal",
    "bespoke",
    "simulation",
    "triage"
  ],
  "license": "Elastic-2.0",
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.4"
  }
}
