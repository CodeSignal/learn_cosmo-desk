      {
        "id": "tiers",
        "title": "Handling tier",
        "blocks": [
          {
            "type": "list",
            "items": [
              "Emergency: anyone injured, or a home that is unsafe to live in.",
              "Fast track: estimated loss under 2,000 with no injury and a clear cause.",
              "Standard: everything else.",
              "Priority care: when the policyholder record shows Priority care, the claim is never Standard. Use Fast track unless it is an Emergency.",
              "How upset or insistent the claimant is does not change the tier."
            ]
          }
        ]
      },
      {
        "id": "referrals",
        "title": "Referrals and duplicates",
        "blocks": [
          {
            "type": "list",
            "items": [
              "Refer to the Special investigations unit when a policy started less than 30 days before the loss, or when the claimant's account of the loss changes.",
              "Refer to the Special investigations unit when the policyholder record shows two or more earlier claims in the 12 months before this one. Older claims do not count.",
              "Refer to the Catastrophe team when the loss comes from the declared River Vale flood event.",
              "If both apply, refer to the Special investigations unit.",
              "Merge a second report of the same loss into the earliest report."
            ]
          }
        ]
      },
      {
        "id": "replies",
        "title": "Writing to claimants",
        "replyRules": true,
        "blocks": [
          {
            "type": "paragraph",
            "text": "Write to every claimant whose claim is referred to the Special investigations unit or the Catastrophe team. Other claimants hear from their claims unit, not from intake."
          },
          {
            "type": "list",
            "items": [
              "Use the claimant's name and quote the claim number.",
              "Say which team the claim is referred to and that they will call within one working day.",
              "Ask for photos of the damage and, for theft, the police report number.",
              "Never say whether the claim will be paid or how much."
            ]
          }
        ]
      }
    ]
  },
